{
  "name": "course-mapper",
  "version": "0.20.9",
  "type": "module",
  "description": "Editable, linked educational materials with source-grounded generation and classroom exports",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/cleanDist.mjs && node scripts/buildScionRuntime.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "start": "npm run preview",
    "check": "npm run typecheck && npm run lint && npm test && npm run test:authoring && npm run test:compatibility && npm run test:scion && npm run benchmark:outputs:test && npm run benchmark:outputs:strict && npm run benchmark:acceptance:test && npm run build && npm run bundle:check",
    "typecheck": "npm run studio:typecheck && npm run scion:typecheck",
    "studio:typecheck": "tsc -p tsconfig.studio.json",
    "scion:typecheck": "tsc -p tsconfig.scion.json",
    "test": "vitest run --config vitest.studio.config.ts",
    "test:unit": "npm test",
    "studio:test": "npm test",
    "test:e2e": "playwright test --config playwright.compatibility.config.ts",
    "test:production": "playwright test --config playwright.production.config.ts",
    "lint": "eslint src server scripts tests *.ts *.js --quiet",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "bundle:check": "node scripts/check-application-build.mjs",
    "studio:generate": "node scripts/studio/generate.mjs",
    "scion:serve": "node server/scion/gateway.ts",
    "scion:deploy": "wrangler deploy --config server/scion/wrangler.jsonc",
    "studio:dev": "vite --config vite.studio.config.ts",
    "studio:build": "vite build --config vite.studio.config.ts",
    "test:studio:e2e": "playwright test --config playwright.studio.config.ts",
    "test:compatibility": "vitest run --config vitest.compatibility.config.js",
    "test:scion": "vitest run --config vitest.scion.config.js",
    "benchmark:outputs": "vite-node scripts/benchmarks/runClassroomBenchmark.ts",
    "benchmark:outputs:test": "node --test scripts/benchmarks/classroomBenchmark.test.mjs scripts/benchmarks/scionLiveScore.test.mjs",
    "benchmark:outputs:strict": "vite-node scripts/benchmarks/runClassroomBenchmark.ts --strict --out .audit-work/classroom-benchmark/check",
    "benchmark:acceptance:test": "node --test scripts/benchmarks/classroomAcceptance.test.mjs scripts/benchmarks/inspectClassroomV3.test.mjs scripts/benchmarks/verifyClassroomV3Freeze.test.mjs scripts/benchmarks/classroomV3Probe.test.mjs scripts/benchmarks/classroomV3Checks.test.mjs",
    "benchmark:acceptance": "vite-node scripts/benchmarks/runClassroomAcceptance.ts --split development --strict",
    "benchmark:v3:probe": "vite-node scripts/benchmarks/probeClassroomV3Compiler.mjs",
    "benchmark:v3:inventory": "node scripts/benchmarks/inspectClassroomV3.mjs",
    "benchmark:v3:verify": "node scripts/benchmarks/verifyClassroomV3Freeze.mjs",
    "authoring:server": "node server/authoring/start.mjs",
    "authoring:schemas": "node scripts/authoring/buildValidators.mjs",
    "authoring:cleanup": "node server/authoring/cleanup.mjs",
    "test:authoring": "vitest run --config vitest.authoring.config.js"
  },
  "dependencies": {
    "@cfworker/json-schema": "4.1.1",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lint": "^6.9.6",
    "@codemirror/search": "^6.7.0",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.42.0",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@tiptap/react": "3.31.3",
    "@tiptap/starter-kit": "3.31.3",
    "@uiw/react-codemirror": "^4.25.9",
    "@wllama/wllama": "3.6.1",
    "ajv": "8.20.0",
    "docx": "^9.5.1",
    "dompurify": "^3.4.1",
    "express": "5.2.1",
    "file-saver": "^2.0.5",
    "firebase": "^12.12.1",
    "firebase-admin": "13.7.0",
    "focus-trap-react": "^12.0.0",
    "jose": "6.2.3",
    "jsonrepair": "^3.15.0",
    "jszip": "^3.10.1",
    "mammoth": "^1.12.0",
    "pdfjs-dist": "^4.0.379",
    "pdfmake": "0.2.23",
    "pptxgenjs": "^4.0.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "text-readability": "^1.1.1",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260918.1",
    "@eslint/js": "^9.39.4",
    "@firebase/rules-unit-testing": "^5.0.0",
    "@playwright/test": "^1.58.2",
    "@types/pdfmake": "0.2.12",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.4.17",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "fake-indexeddb": "6.2.4",
    "firebase-tools": "^15.30.2",
    "globals": "^17.6.0",
    "happy-dom": "^20.9.0",
    "postcss": "^8.4.33",
    "prettier": "^3.8.3",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.0.10",
    "vite-node": "^6.0.0",
    "vitest": "^4.1.11",
    "wrangler": "4.135.0"
  },
  "overrides": {
    "pptxgenjs": {
      "image-size": "2.0.4"
    }
  }
}
